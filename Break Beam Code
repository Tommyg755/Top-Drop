void setup () {
  Serial.begin(9600);
  pinMode(4, INPUT_PULLUP);
  pinMode(13, OUTPUT);
  
}

void loop () {
 
 int val = digitalRead(4);

 if (val == 0) 
 {
  digitalWrite(13, LOW);
 }
 else
 {
  digitalWrite(13, HIGH);
 }



 Serial.print("The value of pin 4 is: ");
 Serial.println(val);

 delay(100);

}
